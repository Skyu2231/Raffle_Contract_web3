# Chain the UI reads from when no wallet is connected.
# 11155111 = Sepolia, 31337 = Anvil, 1 = Ethereum mainnet
VITE_CHAIN_ID=11155111

# Deployed Raffle contract address per chain (from `make deploy`)
VITE_RAFFLE_ADDRESS_11155111=
VITE_RAFFLE_ADDRESS_31337=
VITE_RAFFLE_ADDRESS_1=

# Optional RPC overrides. Public RPCs are used when omitted.
VITE_SEPOLIA_RPC_URL=
VITE_MAINNET_RPC_URL=
VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
